# =============================================================================
# Opportunity Intelligence — variables d'environnement (valeurs FICTIVES ou vides)
# Copiez ce fichier en `backend/.env` (backend) et `apps/web/.env.local` (frontend).
# Ne versionnez JAMAIS de vraies valeurs. Voir docs/ENVIRONMENT.md.
# =============================================================================

# ---------- Backend (Render Web Service + Cron Jobs) ----------
# Chaîne Neon (pooled recommandée pour l'API). Format : postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Optionnel : connexion directe (non poolée) Neon pour les migrations Alembic.
DATABASE_MIGRATION_URL=
APP_ENV=development
# Chaîne aléatoire longue (ex. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
# Origines autorisées (séparées par des virgules) — l'URL Vercel en production.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Fuseau par défaut des nouveaux comptes
DEFAULT_TIMEZONE=Europe/Paris
LOG_LEVEL=INFO

# Création sécurisée du compte administrateur (une seule fois, puis supprimer le mot de passe)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# E-mails (Resend). Sans RESEND_API_KEY : mode simulation, aucun e-mail externe.
RESEND_API_KEY=
EMAIL_FROM=
ALERT_RECIPIENT=
# Adresses supplémentaires autorisées à recevoir des e-mails (séparées par des virgules)
EMAIL_ALLOWED_RECIPIENTS=

# Assistant IA (facultatif). Vide = fonctionnalité désactivée proprement.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Stockage des documents : local | s3 | none
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_MB=4

# Collecte : identifiant HTTP poli envoyé aux sources
COLLECTOR_USER_AGENT=OpportunityIntelligence/1.0 (+https://github.com/votre-compte/opportunity-intelligence)

# ---------- Frontend (Vercel) ----------
# URL HTTPS du backend Render (utilisée côté serveur Next.js uniquement)
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exposée au navigateur : uniquement l'URL publique de l'API (aucun secret)
NEXT_PUBLIC_API_URL=http://localhost:8000
